{
  "name": "vscode-folder-file-filter",
  "displayName": "Folder File Filter",
  "description": "Filter folder files by glob, extension, or active file context inside VS Code Explorer.",
  "version": "0.0.19",
  "publisher": "applicate2628",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/applicate2628/vscode-folder-file-filter.git"
  },
  "homepage": "https://github.com/applicate2628/vscode-folder-file-filter#readme",
  "bugs": {
    "url": "https://github.com/applicate2628/vscode-folder-file-filter/issues"
  },
  "galleryBanner": {
    "color": "#1f6f6d",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Folder File Filter only reads workspace files through VS Code APIs and stores workspace-relative pinned folder metadata."
    }
  },
  "keywords": [
    "folder",
    "files",
    "filter",
    "filter files",
    "folder filter",
    "file-filter",
    "explorer",
    "file explorer",
    "file browser",
    "find files",
    "glob",
    "glob mask",
    "file mask",
    "search",
    "folder search",
    "quick-open",
    "context menu",
    "multi-select",
    "active file",
    "same folder",
    "extension filter",
    "productivity",
    "tree-view"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:folderFileFilter.showMatchingFiles",
    "onCommand:folderFileFilter.showMatchingFilesFromFile",
    "onCommand:folderFileFilter.refresh",
    "onCommand:folderFileFilter.changeMask",
    "onCommand:folderFileFilter.changeSourceFolder",
    "onCommand:folderFileFilter.saveFilter",
    "onCommand:folderFileFilter.pinSourceFolder",
    "onCommand:folderFileFilter.openPinnedFolder",
    "onCommand:folderFileFilter.unpinFolder",
    "onCommand:folderFileFilter.changeSort",
    "onCommand:folderFileFilter.toggleGroupByExtension",
    "onCommand:folderFileFilter.clear",
    "onCommand:folderFileFilter.openSettings",
    "onCommand:folderFileFilter.openResult",
    "onCommand:folderFileFilter.openResultToSide",
    "onCommand:folderFileFilter.revealResultInOS",
    "onCommand:folderFileFilter.copyResultPath",
    "onCommand:folderFileFilter.copyResultRelativePath",
    "onCommand:folderFileFilter.focusDownAndSelect",
    "onCommand:folderFileFilter.focusUpAndSelect",
    "onView:folderFileFilter.results"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Folder File Filter",
      "properties": {
        "folderFileFilter.defaultMask": {
          "type": "string",
          "default": "**/*",
          "order": 1,
          "description": "Default glob mask shown when filtering files in a selected folder.",
          "markdownDescription": "Default glob mask shown when filtering files in a selected folder."
        },
        "folderFileFilter.maskPresets": {
          "type": "array",
          "default": [
            "**/*",
            "*.*",
            "**/*.*",
            "**/README*",
            "**/test*",
            "**/*test*",
            "**/*.test.*",
            "**/*.spec.*",
            "**/__tests__/**",
            "**/docs/**",
            "**/src/**",
            "**/*-backup*",
            "**/*_backup*"
          ],
          "order": 2,
          "description": "Generic glob patterns shown after current-folder extensions and recent masks in the Folder File Filter mask picker.",
          "markdownDescription": "Generic glob patterns shown after current-folder extensions and recent masks in the Folder File Filter mask picker.",
          "items": {
            "type": "string"
          }
        },
        "folderFileFilter.maxResults": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 5000,
          "order": 3,
          "description": "Maximum number of files returned by one folder file filter search.",
          "markdownDescription": "Maximum number of files returned by one folder file filter search."
        },
        "folderFileFilter.savedFilters": {
          "type": "array",
          "default": [],
          "order": 4,
          "description": "Named glob masks shown in the Folder File Filter mask picker.",
          "markdownDescription": "Named glob masks shown in the Folder File Filter mask picker.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "mask"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "description": "Saved filter name shown in the mask picker."
              },
              "mask": {
                "type": "string",
                "description": "Glob mask used by this saved filter."
              }
            }
          }
        },
        "folderFileFilter.sortBy": {
          "type": "string",
          "default": "path",
          "enum": [
            "path",
            "name",
            "extension"
          ],
          "order": 5,
          "description": "Sort order used for Folder File Filter results.",
          "markdownDescription": "Sort order used for Folder File Filter results."
        },
        "folderFileFilter.groupByExtension": {
          "type": "boolean",
          "default": false,
          "order": 6,
          "description": "Group Folder File Filter results by file extension.",
          "markdownDescription": "Group Folder File Filter results by file extension."
        },
        "folderFileFilter.autoRefreshResults": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "Automatically refresh active Folder File Filter results when matching files are created, changed, or deleted.",
          "markdownDescription": "Automatically refresh active Folder File Filter results when matching files are created, changed, or deleted."
        },
        "folderFileFilter.autoRefreshDebounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "order": 8,
          "description": "Delay before auto-refreshing Folder File Filter results after file changes.",
          "markdownDescription": "Delay before auto-refreshing Folder File Filter results after file changes."
        },
        "folderFileFilter.openOnSelection": {
          "type": "boolean",
          "default": false,
          "order": 9,
          "description": "Open the selected result immediately while moving through the Folder File Filter results list. Files open with their default editor in preview mode and focus stays in the results view.",
          "markdownDescription": "Open the selected result immediately while moving through the Folder File Filter results list. Files open with their default editor in preview mode and focus stays in the results view."
        },
        "folderFileFilter.autoFilterFilesFromSelectedFile": {
          "type": "boolean",
          "default": true,
          "order": 10,
          "description": "When running Folder File Filter from a file, immediately show files in the same folder that match the selected file extension. Disable to confirm or edit the inferred mask first.",
          "markdownDescription": "When running Folder File Filter from a file, immediately show files in the same folder that match the selected file extension. Disable to confirm or edit the inferred mask first."
        },
        "folderFileFilter.autoFilterFromActiveFile": {
          "type": "boolean",
          "default": true,
          "order": 11,
          "description": "Automatically update Folder File Filter when the active editor tab changes to a file. The filter uses that file's parent folder and inferred extension mask.",
          "markdownDescription": "Automatically update Folder File Filter when the active editor tab changes to a file. The filter uses that file's parent folder and inferred extension mask."
        },
        "folderFileFilter.restoreFocusAfterOpenDelayMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "order": 12,
          "description": "Delay before Folder File Filter restores focus again after auto-opening a result. Increase this if a custom editor takes focus after opening; set to 0 to disable delayed refocus.",
          "markdownDescription": "Delay before Folder File Filter restores focus again after auto-opening a result. Increase this if a custom editor takes focus after opening; set to `0` to disable delayed refocus."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "folderFileFilter.results",
          "name": "Folder File Filter"
        }
      ]
    },
    "commands": [
      {
        "command": "folderFileFilter.showMatchingFiles",
        "title": "Folder File Filter: Show Matching Files",
        "icon": "$(filter)"
      },
      {
        "command": "folderFileFilter.showMatchingFilesFromFile",
        "title": "Folder File Filter",
        "icon": "$(filter)"
      },
      {
        "command": "folderFileFilter.refresh",
        "title": "Folder File Filter: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "folderFileFilter.changeMask",
        "title": "Folder File Filter: Change Mask",
        "icon": "$(edit)"
      },
      {
        "command": "folderFileFilter.changeSourceFolder",
        "title": "Folder File Filter: Change Source Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "folderFileFilter.saveFilter",
        "title": "Folder File Filter: Save Filter",
        "icon": "$(star-full)"
      },
      {
        "command": "folderFileFilter.pinSourceFolder",
        "title": "Folder File Filter: Pin Source Folder",
        "icon": "$(pinned)"
      },
      {
        "command": "folderFileFilter.openPinnedFolder",
        "title": "Open Pinned Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "folderFileFilter.unpinFolder",
        "title": "Folder File Filter: Unpin Folder",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "folderFileFilter.changeSort",
        "title": "Folder File Filter: Change Sort",
        "icon": "$(list-ordered)"
      },
      {
        "command": "folderFileFilter.toggleGroupByExtension",
        "title": "Folder File Filter: Toggle Group By Extension",
        "icon": "$(symbol-folder)"
      },
      {
        "command": "folderFileFilter.clear",
        "title": "Folder File Filter: Clear",
        "icon": "$(clear-all)"
      },
      {
        "command": "folderFileFilter.openSettings",
        "title": "Folder File Filter: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "folderFileFilter.openResult",
        "title": "Open",
        "icon": "$(go-to-file)"
      },
      {
        "command": "folderFileFilter.openResultToSide",
        "title": "Open to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "folderFileFilter.revealResultInOS",
        "title": "Reveal in File Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "folderFileFilter.copyResultPath",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "folderFileFilter.copyResultRelativePath",
        "title": "Copy Relative Path",
        "icon": "$(copy)"
      }
    ],
    "keybindings": [
      {
        "command": "folderFileFilter.focusDownAndSelect",
        "key": "down",
        "when": "focusedView == folderFileFilter.results && config.folderFileFilter.openOnSelection && viewItem == folderFileFilter.file"
      },
      {
        "command": "folderFileFilter.focusUpAndSelect",
        "key": "up",
        "when": "focusedView == folderFileFilter.results && config.folderFileFilter.openOnSelection && viewItem == folderFileFilter.file"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "folderFileFilter.openResult",
          "when": "false"
        },
        {
          "command": "folderFileFilter.openResultToSide",
          "when": "false"
        },
        {
          "command": "folderFileFilter.revealResultInOS",
          "when": "false"
        },
        {
          "command": "folderFileFilter.copyResultPath",
          "when": "false"
        },
        {
          "command": "folderFileFilter.copyResultRelativePath",
          "when": "false"
        },
        {
          "command": "folderFileFilter.openPinnedFolder",
          "when": "false"
        },
        {
          "command": "folderFileFilter.unpinFolder",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "folderFileFilter.showMatchingFilesFromFile",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "folderFileFilter.changeSourceFolder",
          "when": "view == folderFileFilter.results",
          "group": "navigation@0"
        },
        {
          "command": "folderFileFilter.changeMask",
          "when": "view == folderFileFilter.results",
          "group": "navigation@1"
        },
        {
          "command": "folderFileFilter.saveFilter",
          "when": "view == folderFileFilter.results",
          "group": "navigation@2"
        },
        {
          "command": "folderFileFilter.pinSourceFolder",
          "when": "view == folderFileFilter.results",
          "group": "navigation@3"
        },
        {
          "command": "folderFileFilter.changeSort",
          "when": "view == folderFileFilter.results",
          "group": "navigation@4"
        },
        {
          "command": "folderFileFilter.toggleGroupByExtension",
          "when": "view == folderFileFilter.results",
          "group": "navigation@5"
        },
        {
          "command": "folderFileFilter.refresh",
          "when": "view == folderFileFilter.results",
          "group": "navigation@6"
        },
        {
          "command": "folderFileFilter.clear",
          "when": "view == folderFileFilter.results",
          "group": "navigation@7"
        },
        {
          "command": "folderFileFilter.openSettings",
          "when": "view == folderFileFilter.results",
          "group": "navigation@8"
        }
      ],
      "view/item/context": [
        {
          "command": "folderFileFilter.changeMask",
          "when": "view == folderFileFilter.results && viewItem == folderFileFilter.filter",
          "group": "navigation@0"
        },
        {
          "command": "folderFileFilter.openResult",
          "when": "view == folderFileFilter.results && viewItem == folderFileFilter.file",
          "group": "navigation@1"
        },
        {
          "command": "folderFileFilter.openResultToSide",
          "when": "view == folderFileFilter.results && viewItem == folderFileFilter.file",
          "group": "navigation@2"
        },
        {
          "command": "folderFileFilter.revealResultInOS",
          "when": "view == folderFileFilter.results && viewItem == folderFileFilter.file",
          "group": "2_workspace@1"
        },
        {
          "command": "folderFileFilter.copyResultPath",
          "when": "view == folderFileFilter.results && viewItem == folderFileFilter.file",
          "group": "3_copy@1"
        },
        {
          "command": "folderFileFilter.copyResultRelativePath",
          "when": "view == folderFileFilter.results && viewItem == folderFileFilter.file",
          "group": "3_copy@2"
        },
        {
          "command": "folderFileFilter.unpinFolder",
          "when": "view == folderFileFilter.results && (viewItem == folderFileFilter.pinnedFolder || viewItem == folderFileFilter.pinnedFolder.stale)",
          "group": "navigation@0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "folderFileFilter.results",
        "contents": "Right-click a folder in Explorer and run `Folder File Filter: Show Matching Files`."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/__tests__/*.test.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --no-dependencies --readme-path README.marketplace.md",
    "release:patch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-patch.ps1",
    "release:patch:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-patch.ps1",
    "release:patch:bash": "bash scripts/release-patch.sh"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.4.5"
  }
}
