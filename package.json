{
  "name": "vscode-folder-file-filter",
  "displayName": "Folder File Filter",
  "description": "Find matching Markdown, config, test, log, or asset files inside a selected Explorer folder.",
  "version": "0.0.9",
  "publisher": "applicate2628",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/applicate2628/vscode-folder-file-filter.git"
  },
  "homepage": "https://github.com/applicate2628/vscode-folder-file-filter#readme",
  "bugs": {
    "url": "https://github.com/applicate2628/vscode-folder-file-filter/issues"
  },
  "keywords": [
    "files",
    "filter",
    "explorer",
    "glob",
    "search"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:folderFileFilter.showMatchingFiles",
    "onCommand:folderFileFilter.refresh",
    "onCommand:folderFileFilter.clear",
    "onCommand:folderFileFilter.focusDownAndSelect",
    "onCommand:folderFileFilter.focusUpAndSelect",
    "onView:folderFileFilter.results"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Folder File Filter",
      "properties": {
        "folderFileFilter.defaultMask": {
          "type": "string",
          "default": "**/*",
          "order": 1,
          "description": "Default glob mask shown when filtering files in a selected folder.",
          "markdownDescription": "Default glob mask shown when filtering files in a selected folder."
        },
        "folderFileFilter.maxResults": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "order": 2,
          "description": "Maximum number of files returned by one folder file filter search.",
          "markdownDescription": "Maximum number of files returned by one folder file filter search."
        },
        "folderFileFilter.openOnSelection": {
          "type": "boolean",
          "default": false,
          "order": 3,
          "description": "Open the selected result immediately while moving through the Folder File Filter results list. Files open in preview mode and focus stays in the results view.",
          "markdownDescription": "Open the selected result immediately while moving through the Folder File Filter results list. Files open in preview mode and focus stays in the results view."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "folderFileFilter.results",
          "name": "Folder File Filter"
        }
      ]
    },
    "commands": [
      {
        "command": "folderFileFilter.showMatchingFiles",
        "title": "Folder File Filter: Show Matching Files",
        "icon": "$(filter)"
      },
      {
        "command": "folderFileFilter.refresh",
        "title": "Folder File Filter: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "folderFileFilter.clear",
        "title": "Folder File Filter: Clear",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "folderFileFilter.focusDownAndSelect",
        "key": "down",
        "when": "focusedView == folderFileFilter.results && config.folderFileFilter.openOnSelection"
      },
      {
        "command": "folderFileFilter.focusUpAndSelect",
        "key": "up",
        "when": "focusedView == folderFileFilter.results && config.folderFileFilter.openOnSelection"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "folderFileFilter.showMatchingFiles",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "folderFileFilter.refresh",
          "when": "view == folderFileFilter.results",
          "group": "navigation"
        },
        {
          "command": "folderFileFilter.clear",
          "when": "view == folderFileFilter.results",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "folderFileFilter.results",
        "contents": "Right-click a folder in Explorer and run `Folder File Filter: Show Matching Files`."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/__tests__/*.test.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --no-dependencies --readme-path README.marketplace.md",
    "release:patch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-patch.ps1",
    "release:patch:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-patch.ps1",
    "release:patch:bash": "bash scripts/release-patch.sh"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.4.5"
  }
}
